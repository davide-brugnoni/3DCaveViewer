    "@gltf-transform/extensions": "^4.1.0",
    "@gltf-transform/functions": "^4.1.0",
    "draco3d": "^1.5.7",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "obj2gltf": "^3.2.0",
    "sharp": "^0.33.4"
  }
}
