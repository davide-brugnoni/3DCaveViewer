{
  "name": "glb-optimizer-desktop",
  "productName": "GLB Optimizer",
  "version": "1.0.1",
  "description": "GLB Optimizer di 3DCaveViewer come applicazione Windows con finestra propria",
  "author": "Davide Brugnoni",
  "license": "GPL-3.0-only",
  "homepage": "https://www.3dcaveviewer.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/davide-brugnoni/3DCaveViewer.git",
    "directory": "EXE_GLB_OPTIMIZER"
  },
  "private": true,
  "type": "module",
  "main": "app/main.cjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "prepare-app": "node scripts/prepare.mjs",
    "start": "node scripts/prepare.mjs --no-runtime && electron .",
    "pack": "node scripts/prepare.mjs && electron-builder --win dir --x64",
    "dist": "npm run pack && node scripts/build-installer.mjs",
    "test": "node scripts/smoke-test.mjs"
  },
  "dependencies": {
    "@gltf-transform/core": "^4.1.0",
    "@gltf-transform/extensions": "^4.1.0",
    "@gltf-transform/functions": "^4.1.0",
    "draco3d": "^1.5.7",
    "express": "^4.19.2",
    "multer": "^1.4.5-lts.1",
    "obj2gltf": "^3.2.0",
    "sharp": "^0.33.4"
  },
  "devDependencies": {
    "electron": "44.9.0",
    "electron-builder": "26.17.0"
  },
  "build": {
    "appId": "com.3dcaveviewer.glboptimizer",
    "productName": "GLB Optimizer",
    "executableName": "GLB Optimizer",
    "copyright": "© Davide Brugnoni — GNU GPL v3",
    "asar": false,
    "npmRebuild": false,
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "package.json",
      "app/**/*",
      "server/**/*",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime",
        "filter": [
          "node.exe",
          "LICENSE*"
        ]
      },
      {
        "from": "../LICENSE",
        "to": "LICENSE.txt"
      }
    ],
    "win": {
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "publish": null
  }
}
